# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Launcher runtime / user data. The installed client under .vanta-data/game
# is tracked (jars, libraries, assets, mods). Everything else in .vanta-data stays out.
.vanta-data/*
!.vanta-data/game/

# Accounts, tokens, and passwords (still ignored inside the game tree)
.vanta-data/accounts/
.vanta-data/accounts/**
accounts.json
*token*
*password*
*secret*
*credential*
.env
.env.*
*.pem
*.key
*.pfx
*.p12

# Logs and crash dumps (can contain session details)
*.log
crash-reports/

# WebView2 user data
.vanta-data/webview2/
EBWebView/
WebView2/
*.WebView2/

# OS junk
.DS_Store
Thumbs.db

# Game runtime logs (may include session details); keep jars/assets/mods
.vanta-data/game/**/logs/
*.log.gz
